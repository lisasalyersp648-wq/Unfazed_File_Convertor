# Never ship local secrets, state, or virtualenvs to the Docker builder.
.git
.gitignore
.vercel
.vercelignore
.env
.env.*
!.env.example
converter_bot/.env
converter_bot/.env.*
!converter_bot/.env.example

.venv
venv
**/__pycache__
**/*.py[cod]
*.egg-info

bot_data
converter_bot/bot_data
**/*.db
**/*.db-shm
**/*.db-wal
**/*.db-journal

.pytest_cache
.mypy_cache
.ruff_cache
*.log
README.md
