# Local development configuration. Copy to `.env` in this directory when
# running `python bot.py` from here. The canonical, fully documented template
# is ../.env.example.

BOT_TOKEN=
LOG_LEVEL=INFO
MAX_WORKERS=4
TEMP_DIR=

# Optional self-hosted Bot API server, which bypasses the 20 MB download
# limit. Docker Compose sets this to http://telegram-bot-api:8081 itself, so
# leave it empty for the default (cloud) long-polling setup.
LOCAL_API_URL=
LOCAL_API_MODE=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Postgres is optional locally; SQLite is used when this is empty.
DATABASE_URL=
DB_PATH=

# Webhook mode (leave empty to use long polling locally).
RUN_MODE=
WEBHOOK_URL=
WEBHOOK_PATH=/api/webhook
WEBHOOK_SECRET=
AUTO_SET_WEBHOOK=false

# Media requires ffmpeg on PATH (installed in the Docker image).
ENABLE_MEDIA=

# Optional Library Bot bridge.
STORAGE_CHANNEL_ID=
DEEPLINK_SECRET=
