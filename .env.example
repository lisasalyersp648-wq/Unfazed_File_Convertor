# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Telegram BotFather token (<bot_id>:<secret>).
BOT_TOKEN=

# ---------------------------------------------------------------------------
# Webhook (Vercel)
# ---------------------------------------------------------------------------
# On Vercel production the public URL is discovered from VERCEL_PROJECT_
# PRODUCTION_URL automatically. Set WEBHOOK_URL explicitly for other hosts or
# preview deployments.
WEBHOOK_URL=
WEBHOOK_PATH=/api/webhook

# Required whenever WEBHOOK_URL is set. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# Register the webhook automatically on the first request/cold start.
# Defaults to true on Vercel when WEBHOOK_URL is known.
AUTO_SET_WEBHOOK=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon/Vercel Postgres connection string. VERCEL_POSTGRES also exposes
# POSTGRES_URL and POSTGRES_PRISMA_URL aliases; any of them works.
# Without it, SQLite is used (fine locally, not durable on Vercel).
DATABASE_URL=
# Optional: true/false. Defaults to true for non-local hosts.
DATABASE_SSL=
DB_POOL_SIZE=2
# SQLite path (local development only).
DB_PATH=

# Optional: explicit dotenv file. Defaults to .env in the working directory.
DOTENV_PATH=

# ---------------------------------------------------------------------------
# Runtime tuning
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
MAX_WORKERS=
MAX_CONCURRENT_CONVERSIONS=4
CONVERSION_TIMEOUT=240
# 0 = per-category limits (document 50 MB, image 30 MB).
MAX_INPUT_MB=0
# Defaults to /tmp on Vercel, /dev/shm when available locally.
TEMP_DIR=

# Audio/video require ffmpeg. Defaults to enabled only when ffmpeg is found.
ENABLE_MEDIA=
FFMPEG_BIN=

# ---------------------------------------------------------------------------
# Local Bot API server (self-hosted / Docker only, never on Vercel)
# ---------------------------------------------------------------------------
# Removes Telegram's 20 MB download limit. Leave both empty for cloud mode.
LOCAL_API_URL=
LOCAL_API_MODE=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---------------------------------------------------------------------------
# Optional Library Bot deep-link bridge
# ---------------------------------------------------------------------------
# Numeric id (-100...) of the private storage channel; both bots must be
# administrators.
STORAGE_CHANNEL_ID=
# Must match the Library bot's DEEPLINK_SECRET. Required when
# STORAGE_CHANNEL_ID is set.
DEEPLINK_SECRET=

# ---------------------------------------------------------------------------
# Local runner only
# ---------------------------------------------------------------------------
# polling (default) or webhook.
RUN_MODE=
DROP_PENDING_UPDATES=false
